# Writes a C++ source that returns the version string, read from git.
#
# Run in script mode at BUILD time, not at configure time:
# cmake -DOUT=<file> -DSOURCE_DIR=<repo> -P cmake/GenerateVersion.cmake
# A version read at configure time goes stale as soon as a tag is added or a
# commit is made without re-running cmake. Here the string is checked on every
# build, and the file is rewritten only when it changes, so nothing is
# recompiled or relinked on an ordinary build.
#
# The string is 'git describe' with the project's tag pattern:
# v0.1.0 built exactly at tag v0.1.0
# v0.1.0-3-g1a2b3c4 three commits after it, at commit 1a2b3c4
# 1a2b3c4 no tag reachable (a fresh clone with depth 1)
# ...-dirty uncommitted changes in the tree
# unknown not a git checkout (a source tarball)
# scripts/package.sh asks git the same question, so the file name of a
# release and the string inside its binary cannot disagree.
execute_process(
    COMMAND git -C "${SOURCE_DIR}" describe --tags --always --dirty --match "v*"
    OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE status
    ERROR_QUIET
)
if(NOT status EQUAL 0 OR version STREQUAL "")
    set(version "unknown")
endif()

set(content "// Generated by cmake/GenerateVersion.cmake at build time. Do not edit.
#include \"Version.h\"

const char* chargerVersion() { return \"${version}\"; }
")

# Compare before writing: an unchanged file keeps its timestamp, and the
# build system sees nothing to do.
set(current "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL content)
    file(WRITE "${OUT}" "${content}")
    message(STATUS "version ${version}")
endif()